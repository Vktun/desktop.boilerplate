<UserControl x:Class="Vk.Dbp.DeviceModule.Views.ReportCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1180">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PrimaryBackgroundBrush}" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="{DynamicResource SecondaryBackgroundBrush}" Padding="15,10" CornerRadius="4" Margin="0,0,0,10">
            <TextBlock Text="报表中心" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
        </Border>

        <TabControl Grid.Row="1" Background="Transparent">
            <!-- 告警报表 -->
            <TabItem Header="告警报表">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource PrimaryBackgroundBrush}" Padding="10,8" CornerRadius="4" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="种类:" VerticalAlignment="Center" Margin="0,0,6,0"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <ComboBox ItemsSource="{Binding AlarmReport.ReportKinds}" SelectedItem="{Binding AlarmReport.SelectedReportKind}" Width="90"/>
                            <TextBlock Text="日期:" VerticalAlignment="Center" Margin="16,0,6,0"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <DatePicker Width="140" SelectedDate="{Binding AlarmReport.SelectedDate}"/>
                            <Button Content="生成" Command="{Binding AlarmReport.QueryCommand}"
                                    Style="{StaticResource ButtonPrimary}" Height="28" Padding="16,0" Margin="16,0,0,0"/>
                            <Button Content="导出 Excel" Command="{Binding AlarmReport.ExportExcelCommand}"
                                    Style="{StaticResource ButtonDefault}" Height="28" Padding="12,0" Margin="8,0,0,0"/>
                            <Button Content="导出 PDF" Command="{Binding AlarmReport.ExportPdfCommand}"
                                    Style="{StaticResource ButtonDefault}" Height="28" Padding="12,0" Margin="8,0,0,0"/>
                            <hc:LoadingCircle Visibility="{Binding AlarmReport.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              Width="18" Height="18" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AlarmReport.TotalCount, StringFormat='合计 {0} 条'}" Margin="16,0,0,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="{Binding AlarmReport.CriticalCount, StringFormat='严重 {0} 条'}" Margin="10,0,0,0"
                                           VerticalAlignment="Center" Foreground="#EF4444"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding AlarmReport.Rows}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              Background="Transparent" BorderThickness="0"
                              RowBackground="Transparent"
                              AlternatingRowBackground="{DynamicResource SecondaryBackgroundBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="告警来源" Binding="{Binding Source}" Width="*"/>
                            <DataGridTextColumn Header="等级" Binding="{Binding LevelText}" Width="90"/>
                            <DataGridTextColumn Header="数量" Binding="{Binding Count}" Width="80"/>
                            <DataGridTextColumn Header="占比(%)" Binding="{Binding Percent, StringFormat={}{0:0.0}}" Width="90"/>
                            <DataGridTextColumn Header="活跃" Binding="{Binding ActiveCount}" Width="80"/>
                            <DataGridTextColumn Header="已解决" Binding="{Binding ResolvedCount}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 点位班报 -->
            <TabItem Header="点位班报">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource PrimaryBackgroundBrush}" Padding="10,8" CornerRadius="4" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="设备:" VerticalAlignment="Center" Margin="0,0,6,0"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <ComboBox ItemsSource="{Binding ShiftReport.Devices}" SelectedItem="{Binding ShiftReport.SelectedDevice}"
                                      Width="160">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding Code, Mode=OneWay}"/>
                                            <Run Text="{Binding Name, Mode=OneWay, StringFormat=' · {0}'}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="班次:" VerticalAlignment="Center" Margin="16,0,6,0"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <ComboBox ItemsSource="{Binding ShiftReport.ShiftPresets}" SelectedItem="{Binding ShiftReport.SelectedShift}" Width="90"/>
                            <TextBlock Text="日期:" VerticalAlignment="Center" Margin="16,0,6,0"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <DatePicker Width="140" SelectedDate="{Binding ShiftReport.ReferenceDate}"
                                        IsEnabled="{Binding ShiftReport.IsPresetShift}"/>
                            <hc:DateTimePicker SelectedDateTime="{Binding ShiftReport.CustomStart}" Width="170" Margin="10,0,0,0"
                                               IsEnabled="{Binding ShiftReport.IsCustomShift}"/>
                            <TextBlock Text="~" VerticalAlignment="Center" Margin="4,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <hc:DateTimePicker SelectedDateTime="{Binding ShiftReport.CustomEnd}" Width="170"
                                               IsEnabled="{Binding ShiftReport.IsCustomShift}"/>
                            <Button Content="生成" Command="{Binding ShiftReport.QueryCommand}"
                                    Style="{StaticResource ButtonPrimary}" Height="28" Padding="16,0" Margin="16,0,0,0"/>
                            <Button Content="导出 Excel" Command="{Binding ShiftReport.ExportExcelCommand}"
                                    Style="{StaticResource ButtonDefault}" Height="28" Padding="12,0" Margin="8,0,0,0"/>
                            <hc:LoadingCircle Visibility="{Binding ShiftReport.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              Width="18" Height="18" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding ShiftReport.Rows}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              Background="Transparent" BorderThickness="0"
                              RowBackground="Transparent"
                              AlternatingRowBackground="{DynamicResource SecondaryBackgroundBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="点位编码" Binding="{Binding PointCode}" Width="150"/>
                            <DataGridTextColumn Header="点位名称" Binding="{Binding PointName}" Width="*"/>
                            <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="70"/>
                            <DataGridTextColumn Header="最小值" Binding="{Binding Min, StringFormat={}{0:0.####}}" Width="100"/>
                            <DataGridTextColumn Header="最大值" Binding="{Binding Max, StringFormat={}{0:0.####}}" Width="100"/>
                            <DataGridTextColumn Header="平均值" Binding="{Binding Avg, StringFormat={}{0:0.####}}" Width="100"/>
                            <DataGridTextColumn Header="样本数" Binding="{Binding Count}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 审计报表 -->
            <TabItem Header="审计报表">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource PrimaryBackgroundBrush}" Padding="10,8" CornerRadius="4" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="开始:" VerticalAlignment="Center" Margin="0,0,6,0"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <DatePicker Width="140" SelectedDate="{Binding AuditReport.StartDate}"/>
                            <TextBlock Text="结束:" VerticalAlignment="Center" Margin="16,0,6,0"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <DatePicker Width="140" SelectedDate="{Binding AuditReport.EndDate}"/>
                            <TextBlock Text="操作类型:" VerticalAlignment="Center" Margin="16,0,6,0"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <ComboBox ItemsSource="{Binding AuditReport.ActionTypeOptions}" SelectedItem="{Binding AuditReport.SelectedActionType}" Width="110"/>
                            <hc:TextBox Text="{Binding AuditReport.ModuleText, UpdateSourceTrigger=PropertyChanged}"
                                        hc:InfoElement.Placeholder="模块（可选）" Width="140" Margin="10,0,0,0"/>
                            <Button Content="查询" Command="{Binding AuditReport.QueryCommand}"
                                    Style="{StaticResource ButtonPrimary}" Height="28" Padding="16,0" Margin="16,0,0,0"/>
                            <Button Content="导出 Excel" Command="{Binding AuditReport.ExportExcelCommand}"
                                    Style="{StaticResource ButtonDefault}" Height="28" Padding="12,0" Margin="8,0,0,0"/>
                            <hc:LoadingCircle Visibility="{Binding AuditReport.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              Width="18" Height="18" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding AuditReport.Rows}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              Background="Transparent" BorderThickness="0"
                              RowBackground="Transparent"
                              AlternatingRowBackground="{DynamicResource SecondaryBackgroundBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding OperationTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="170"/>
                            <DataGridTextColumn Header="操作人" Binding="{Binding Username}" Width="100"/>
                            <DataGridTextColumn Header="操作类型" Binding="{Binding ActionText}" Width="90"/>
                            <DataGridTextColumn Header="模块" Binding="{Binding Module}" Width="140"/>
                            <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="结果" Binding="{Binding ResultText}" Width="70"/>
                            <DataGridTextColumn Header="失败原因" Binding="{Binding FailureReason}" Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
