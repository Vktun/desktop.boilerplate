<UserControl x:Class="Vk.Dbp.DeviceModule.Views.HistoryQueryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1180">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PrimaryBackgroundBrush}" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="220"/>
        </Grid.RowDefinitions>

        <!-- Row0 查询条件栏 -->
        <Border Grid.Row="0" Background="{DynamicResource SecondaryBackgroundBrush}" Padding="15,10" CornerRadius="4" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="设备:" VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                          DisplayMemberPath="Code" Width="160">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding Code, Mode=OneWay}"/>
                                <Run Text="{Binding Name, Mode=OneWay, StringFormat=' · {0}'}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="点位:" VerticalAlignment="Center" Margin="16,0,6,0"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                <ComboBox ItemsSource="{Binding Points}" SelectedItem="{Binding SelectedPoint}"
                          Width="180">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding Code, Mode=OneWay}"/>
                                <Run Text="{Binding Name, Mode=OneWay, StringFormat=' · {0}'}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="范围:" VerticalAlignment="Center" Margin="16,0,6,0"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                <ComboBox ItemsSource="{Binding RangePresets}" SelectedItem="{Binding SelectedRangePreset}"
                          Width="100"/>

                <hc:DateTimePicker SelectedDateTime="{Binding CustomStart}" Width="170" Margin="10,0,0,0"
                                   IsEnabled="{Binding IsCustomRange}"/>
                <TextBlock Text="~" VerticalAlignment="Center" Margin="4,0"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                <hc:DateTimePicker SelectedDateTime="{Binding CustomEnd}" Width="170"
                                   IsEnabled="{Binding IsCustomRange}"/>

                <Button Content="查询" Command="{Binding QueryCommand}"
                        Style="{StaticResource ButtonPrimary}" Height="28" Padding="16,0" Margin="16,0,0,0"/>
                <Button Content="导出 Excel" Command="{Binding ExportCommand}"
                        Style="{StaticResource ButtonDefault}" Height="28" Padding="12,0" Margin="8,0,0,0"/>
                <hc:LoadingCircle Visibility="{Binding IsQuerying, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  Width="18" Height="18" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Row1 趋势图 + 统计 -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="4,2,4,6">
                    <TextBlock Text="{Binding StatusText}" FontSize="13"
                               Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border Background="{DynamicResource PrimaryBackgroundBrush}" CornerRadius="3" Padding="8,3" Margin="6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="最大 " FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="{Binding MaxText}" FontSize="12" FontWeight="Bold" Foreground="#EF4444"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource PrimaryBackgroundBrush}" CornerRadius="3" Padding="8,3" Margin="6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="最小 " FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="{Binding MinText}" FontSize="12" FontWeight="Bold" Foreground="#3B82F6"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource PrimaryBackgroundBrush}" CornerRadius="3" Padding="8,3" Margin="6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="均值 " FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="{Binding AvgText}" FontSize="12" FontWeight="Bold" Foreground="#10B981"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource PrimaryBackgroundBrush}" CornerRadius="3" Padding="8,3">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="样本 " FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="{Binding CountText}" FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <sp:WpfPlot x:Name="TrendPlot" Grid.Row="1"/>
            </Grid>
        </Border>

        <!-- Row3 明细表 -->
        <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
            <DataGrid ItemsSource="{Binding CurrentSamples}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                      Background="Transparent" BorderThickness="0"
                      RowBackground="Transparent"
                      AlternatingRowBackground="{DynamicResource SecondaryBackgroundBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="时间" Binding="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="200"/>
                    <DataGridTextColumn Header="数值" Binding="{Binding Value, StringFormat={}{0:0.####}}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
