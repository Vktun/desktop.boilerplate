<UserControl
    x:Class="Vk.Dbp.AccountModule.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="Transparent">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <SolidColorBrush x:Key="LoginPrimaryBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="LoginTextBrush" Color="#1E293B"/>
        <SolidColorBrush x:Key="LoginMutedTextBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="LoginPlaceholderBrush" Color="#94A3B8"/>
        <SolidColorBrush x:Key="LoginBorderBrush" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="LoginSoftBlueBrush" Color="#EFF6FF"/>

        <LinearGradientBrush x:Key="LoginButtonBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#2563EB" Offset="0"/>
            <GradientStop Color="#2F6DF6" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="LoginLabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource LoginTextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="LoginInputBorder" TargetType="Border">
            <Setter Property="Height" Value="42"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource LoginBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>

        <Style x:Key="LoginInputTextBox" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource LoginTextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="LoginPasswordBox" TargetType="PasswordBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource LoginTextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="LoginPrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="{StaticResource LoginButtonBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Border Background="White"
                BorderBrush="#D9E2EC"
                BorderThickness="1"
                CornerRadius="10"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.03*"/>
                    <ColumnDefinition Width="1.4*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource LoginSoftBlueBrush}"
                        CornerRadius="10,0,0,10"
                        Padding="44">
                    <Grid>
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="390">
                            <TextBlock Text="欢迎使用 Dabp"
                                       Foreground="{StaticResource LoginTextBrush}"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       TextAlignment="Center"/>
                            <TextBlock Text="高效 · 安全 · 可靠的企业级开发平台"
                                       Foreground="{StaticResource LoginMutedTextBrush}"
                                       FontSize="16"
                                       TextAlignment="Center"
                                       Margin="0,14,0,48"/>

                            <Grid Width="340" Height="250" HorizontalAlignment="Center">
                                <Ellipse Width="300" Height="72"
                                         Fill="#DCEBFF"
                                         Opacity="0.9"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Bottom"
                                         Margin="0,0,0,22"/>
                                <Border Width="180" Height="118"
                                        CornerRadius="8"
                                        BorderBrush="#8DB3FF"
                                        BorderThickness="2"
                                        Background="#ECF4FF"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="18,0,0,28"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <SkewTransform AngleY="-8"/>
                                    </Border.RenderTransform>
                                    <Grid Margin="16">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="22"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="#3B82F6" Margin="0,0,7,0"/>
                                            <Ellipse Width="7" Height="7" Fill="#60A5FA" Margin="0,0,7,0"/>
                                            <Ellipse Width="7" Height="7" Fill="#93C5FD"/>
                                        </StackPanel>
                                        <Canvas Grid.Row="1">
                                            <Path Stroke="#3B82F6"
                                                  StrokeThickness="2"
                                                  Fill="#BFDBFE"
                                                  Data="M 18,55 C 42,24 58,72 82,38 C 104,8 116,60 142,28 L 142,82 L 18,82 Z"/>
                                            <Rectangle Canvas.Left="18" Canvas.Top="10" Width="32" Height="32" RadiusX="16" RadiusY="16" Fill="#DBEAFE"/>
                                            <Rectangle Canvas.Left="18" Canvas.Top="54" Width="56" Height="8" RadiusX="4" RadiusY="4" Fill="#BFDBFE"/>
                                            <Rectangle Canvas.Left="18" Canvas.Top="72" Width="40" Height="8" RadiusX="4" RadiusY="4" Fill="#BFDBFE"/>
                                        </Canvas>
                                    </Grid>
                                </Border>

                                <StackPanel HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="0,28,28,0">
                                    <Border Width="72" Height="64"
                                            CornerRadius="18"
                                            Background="#2563EB"
                                            Padding="13">
                                        <TextBlock Text="D"
                                                   Foreground="White"
                                                   FontSize="32"
                                                   FontWeight="Bold"
                                                   TextAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <UniformGrid Columns="2" Rows="2" Width="86" Height="74" Margin="-6,8,0,0">
                                        <Border Margin="4" CornerRadius="5" Background="#60A5FA"/>
                                        <Border Margin="4" CornerRadius="5" Background="#93C5FD"/>
                                        <Border Margin="4" CornerRadius="5" Background="#BFDBFE"/>
                                        <Border Margin="4" CornerRadius="5" Background="#DBEAFE"/>
                                    </UniformGrid>
                                </StackPanel>

                                <Rectangle Width="18" Height="18"
                                           RadiusX="4"
                                           RadiusY="4"
                                           Fill="#93C5FD"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Top"
                                           Margin="0,34,56,0"/>
                                <Rectangle Width="16" Height="16"
                                           RadiusX="4"
                                           RadiusY="4"
                                           Fill="#60A5FA"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Bottom"
                                           Margin="110,0,0,26"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Background="White"
                        CornerRadius="0,10,10,0"
                        Padding="64,52">
                    <Grid MaxWidth="520"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="用户登录"
                                       Foreground="{StaticResource LoginTextBrush}"
                                       FontSize="28"
                                       FontWeight="Bold"/>
                            <TextBlock Text="欢迎回来！请使用您的账号登录系统"
                                       Foreground="{StaticResource LoginMutedTextBrush}"
                                       FontSize="14"
                                       Margin="0,12,0,38"/>

                            <TextBlock Text="用户名" Style="{StaticResource LoginLabelText}"/>
                            <Border Style="{StaticResource LoginInputBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                        <Path Stroke="{StaticResource LoginPlaceholderBrush}"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Fill="Transparent"
                                              Data="M 12,12 C 14.76,12 17,9.76 17,7 C 17,4.24 14.76,2 12,2 C 9.24,2 7,4.24 7,7 C 7,9.76 9.24,12 12,12 Z M 4,22 C 4.8,17.9 8.1,15.2 12,15.2 C 15.9,15.2 19.2,17.9 20,22"/>
                                    </Viewbox>
                                    <Grid Grid.Column="1" Margin="10,0,0,0">
                                        <TextBox x:Name="UsernameBox"
                                                 Style="{StaticResource LoginInputTextBox}"
                                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="请输入用户名"
                                                   Foreground="{StaticResource LoginPlaceholderBrush}"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=UsernameBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Grid>
                            </Border>

                            <TextBlock Text="密码" Style="{StaticResource LoginLabelText}" Margin="0,28,0,8"/>
                            <Border Style="{StaticResource LoginInputBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                        <Path Stroke="{StaticResource LoginPlaceholderBrush}"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Fill="Transparent"
                                              Data="M 7,10 L 7,7 C 7,4.24 9.24,2 12,2 C 14.76,2 17,4.24 17,7 L 17,10 M 6,10 L 18,10 C 19.1,10 20,10.9 20,12 L 20,20 C 20,21.1 19.1,22 18,22 L 6,22 C 4.9,22 4,21.1 4,20 L 4,12 C 4,10.9 4.9,10 6,10 Z"/>
                                    </Viewbox>
                                    <Grid Grid.Column="1" Margin="10,0,0,0">
                                        <PasswordBox x:Name="PasswordBox"
                                                     Style="{StaticResource LoginPasswordBox}"
                                                     PasswordChanged="PasswordBox_PasswordChanged"/>
                                        <TextBox x:Name="PasswordRevealTextBox"
                                                 Style="{StaticResource LoginInputTextBox}"
                                                 Visibility="Collapsed"
                                                 TextChanged="PasswordRevealTextBox_TextChanged"/>
                                        <TextBlock x:Name="PasswordPlaceholder"
                                                   Text="请输入密码"
                                                   Foreground="{StaticResource LoginPlaceholderBrush}"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"/>
                                    </Grid>
                                    <ToggleButton x:Name="PasswordToggleButton"
                                                  Grid.Column="2"
                                                  Width="24"
                                                  Height="24"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Cursor="Hand"
                                                  Click="PasswordToggleButton_Click">
                                        <Viewbox Width="17" Height="17">
                                            <Path Stroke="{StaticResource LoginPlaceholderBrush}"
                                                  StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Fill="Transparent"
                                                  Data="M 2,12 C 4.3,7.7 7.7,5.5 12,5.5 C 16.3,5.5 19.7,7.7 22,12 C 19.7,16.3 16.3,18.5 12,18.5 C 7.7,18.5 4.3,16.3 2,12 Z M 9.5,12 C 9.5,10.62 10.62,9.5 12,9.5 C 13.38,9.5 14.5,10.62 14.5,12 C 14.5,13.38 13.38,14.5 12,14.5 C 10.62,14.5 9.5,13.38 9.5,12 Z"/>
                                        </Viewbox>
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <Grid Margin="0,22,0,28">
                                <CheckBox Content="记住密码"
                                          IsChecked="{Binding RememberPassword}"
                                          Foreground="{StaticResource LoginTextBrush}"
                                          FontSize="14"/>
                                <TextBlock Text="忘记密码?"
                                           HorizontalAlignment="Right"
                                           Foreground="{StaticResource LoginPrimaryBrush}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Cursor="Hand"/>
                            </Grid>

                            <Button Content="登录"
                                    Style="{StaticResource LoginPrimaryButton}"
                                    Command="{Binding LoginCommand}"
                                    CommandParameter="{Binding ElementName=PasswordBox}"/>

                            <TextBlock Text="还没有账号？联系系统管理员获取访问权限"
                                       Foreground="{StaticResource LoginMutedTextBrush}"
                                       FontSize="14"
                                       TextAlignment="Center"
                                       Margin="0,20,0,0"/>

                            <Border Background="#FEF2F2"
                                    BorderBrush="#FECACA"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,9"
                                    Margin="0,16,0,0"
                                    Visibility="{Binding ShowError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding ErrorMessage}"
                                           Foreground="#DC2626"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <ProgressBar Height="3"
                                         Margin="0,14,0,0"
                                         IsIndeterminate="True"
                                         Foreground="{StaticResource LoginPrimaryBrush}"
                                         Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
