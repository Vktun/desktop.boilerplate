<UserControl
    x:Class="Vk.Dbp.AccountModule.Views.SystemSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource PrimaryBackgroundBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>
            <!-- 会话设置区域 -->
            <Border Background="{DynamicResource SecondaryBackgroundBrush}"
                    CornerRadius="8" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="会话设置" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,20"/>

                    <!-- 启用会话超时 -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="启用会话超时" FontSize="14"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="开启后，用户长时间无操作将自动锁定屏幕"
                                       FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding SessionTimeoutEnabled, Mode=TwoWay}"
                                  HorizontalAlignment="Right"/>
                    </Grid>

                    <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,15"/>

                    <!-- 超时时间 -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="超时时间" FontSize="14"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="用户无操作后自动锁定的时间（单位：分钟，范围：1-480）"
                                       FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                        <hc:NumericUpDown Grid.Column="1"
                                          Value="{Binding SessionTimeoutMinutes, Mode=TwoWay}"
                                          Minimum="1" Maximum="480"
                                          HorizontalAlignment="Right"
                                          Width="120"
                                          IsEnabled="{Binding SessionTimeoutEnabled}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 保存按钮 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="保存设置"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource ButtonPrimary}"
                        Width="100" Height="36"
                        Margin="0,0,10,0"/>
                <Button Content="重置"
                        Command="{Binding ResetCommand}"
                        Width="80" Height="36"/>
            </StackPanel>

            <!-- 状态消息 -->
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{Binding StatusColor}"
                       FontSize="12"
                       Margin="0,10,0,0"
                       Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>