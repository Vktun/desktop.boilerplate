<UserControl x:Class="Vk.Dbp.AccountModule.Views.AlarmConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Vk.Dbp.AccountModule.Views"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Background="{DynamicResource SecondaryBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧配置列表 -->
        <Border Grid.Column="0" Background="{DynamicResource PrimaryBackgroundBrush}" Margin="0,0,5,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <Border Grid.Row="0" Padding="15,12" Background="{DynamicResource SecondaryBackgroundBrush}">
                    <TextBlock Text="告警配置列表" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                </Border>

                <!-- 配置列表 -->
                <ListBox Grid.Row="1" ItemsSource="{Binding AlarmConfigs}"
                         SelectedItem="{Binding SelectedConfig}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="4" CornerRadius="2" Margin="0,0,10,0"
                                        Background="{Binding DisplayColor, Converter={StaticResource StringToColorConverter}}"
                                        VerticalAlignment="Stretch"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding AlarmName}" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <TextBlock Text="{Binding AlarmCode}" FontSize="11"
                                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 底部按钮 -->
                <Border Grid.Row="2" Padding="10" Background="{DynamicResource SecondaryBackgroundBrush}">
                    <Grid>
                        <Button Content="新增" Command="{Binding AddCommand}"
                                Style="{StaticResource ButtonPrimary}" HorizontalAlignment="Left" Padding="20,8"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="编辑" Command="{Binding EditCommand}"
                                    Style="{StaticResource ButtonDefault}" Margin="0,0,10,0" Padding="15,8"/>
                            <Button Content="删除" Command="{Binding DeleteCommand}"
                                    Style="{StaticResource ButtonDanger}" Padding="15,8"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 右侧编辑区域 -->
        <Border Grid.Column="1" Background="{DynamicResource PrimaryBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <Border Grid.Row="0" Padding="15,12" Background="{DynamicResource SecondaryBackgroundBrush}">
                    <TextBlock Text="{Binding EditingConfig.Id, Converter={StaticResource IdToTitleConverter}}"
                               FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                </Border>

                <!-- 编辑表单 -->
                <ScrollViewer Grid.Row="1" Padding="20">
                    <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <!-- 基本信息 -->
                        <TextBlock Text="基本信息" FontWeight="Bold" FontSize="14"
                                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,15"/>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="告警代码:" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <hc:TextBox Grid.Column="1" Text="{Binding EditingConfig.AlarmCode, UpdateSourceTrigger=PropertyChanged}"
                                        hc:InfoElement.Placeholder="如: TEMP_HIGH"/>
                        </Grid>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="配置名称:" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <hc:TextBox Grid.Column="1" Text="{Binding EditingConfig.AlarmName, UpdateSourceTrigger=PropertyChanged}"
                                        hc:InfoElement.Placeholder="如: 温度过高告警"/>
                        </Grid>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="描述:" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <hc:TextBox Grid.Column="1" Text="{Binding EditingConfig.Description}"
                                        hc:InfoElement.Placeholder="告警描述信息" AcceptsReturn="True" Height="60"
                                        TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        </Grid>

                        <hc:Divider Margin="0,10,0,15"/>

                        <!-- 阈值配置 -->
                        <TextBlock Text="阈值配置" FontWeight="Bold" FontSize="14"
                                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,15"/>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="阈值范围:" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <hc:NumericUpDown Grid.Column="1" Value="{Binding EditingConfig.ThresholdMin}"
                                              hc:InfoElement.Placeholder="最小值" Margin="0,0,10,0"/>
                            <hc:NumericUpDown Grid.Column="2" Value="{Binding EditingConfig.ThresholdMax}"
                                              hc:InfoElement.Placeholder="最大值"/>
                        </Grid>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="单位:" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <hc:TextBox Grid.Column="1" Text="{Binding EditingConfig.ThresholdUnit}"
                                        hc:InfoElement.Placeholder="如: ℃" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="2" Text="比较类型:" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <ComboBox Grid.Column="3" ItemsSource="{Binding ComparisonTypes}"
                                      SelectedItem="{Binding EditingConfig.ComparisonType}"/>
                        </Grid>

                        <hc:Divider Margin="0,10,0,15"/>

                        <!-- 通知配置 -->
                        <TextBlock Text="通知配置" FontWeight="Bold" FontSize="14"
                                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,15"/>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="弹窗通知:" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <CheckBox Grid.Column="1" IsChecked="{Binding EditingConfig.EnablePopup}" Margin="0,0,20,0"/>
                            <TextBlock Grid.Column="2" Text="声音提示:" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <CheckBox Grid.Column="3" IsChecked="{Binding EditingConfig.EnableSound}"/>
                        </Grid>

                        <hc:Divider Margin="0,10,0,15"/>

                        <!-- 处理配置 -->
                        <TextBlock Text="处理配置" FontWeight="Bold" FontSize="14"
                                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,15"/>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="自动确认:" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <CheckBox Grid.Column="1" IsChecked="{Binding EditingConfig.AutoAcknowledge}" Margin="0,0,20,0"/>
                            <TextBlock Grid.Column="2" Text="超时时间:" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <hc:NumericUpDown Grid.Column="3" Value="{Binding EditingConfig.AcknowledgeTimeout}"
                                              Minimum="1" Maximum="1440" hc:InfoElement.Placeholder="分钟"/>
                        </Grid>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="优先级:" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <hc:NumericUpDown Grid.Column="1" Value="{Binding EditingConfig.Priority}"
                                              Minimum="0" Maximum="100" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="2" Text="显示颜色:" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <hc:TextBox Grid.Column="3" Text="{Binding EditingConfig.DisplayColor}"
                                        hc:InfoElement.Placeholder="如: Red, Orange, Blue"/>
                        </Grid>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="启用状态:" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <CheckBox Grid.Column="1" IsChecked="{Binding EditingConfig.IsEnabled}"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- 底部按钮 -->
                <Border Grid.Row="2" Padding="15" Background="{DynamicResource SecondaryBackgroundBrush}"
                        Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="保存" Command="{Binding SaveCommand}"
                                Style="{StaticResource ButtonPrimary}" Margin="0,0,10,0" Padding="30,10"/>
                        <Button Content="取消" Command="{Binding CancelCommand}"
                                Style="{StaticResource ButtonDefault}" Padding="30,10"/>
                    </StackPanel>
                </Border>

                <!-- 空状态提示 -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsNotEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="请选择或新增告警配置" FontSize="16"
                               Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- 加载指示器 -->
                <hc:LoadingCircle Grid.Row="1" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>