<UserControl x:Class="Vk.Dbp.WpfWindow.Views.AppAlarmView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Vk.Dbp.WpfWindow.Views"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="{DynamicResource PrimaryBackgroundBrush}"
             mc:Ignorable="d"
             Width="400" Height="500">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource DangerBrush}" Padding="15,12">
            <Grid>
                <TextBlock Text="告警中心" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" Margin="0,0,15,0">
                        <TextBlock Text="活跃: " Foreground="White" VerticalAlignment="Center" Opacity="0.9"/>
                        <TextBlock Text="{Binding ActiveAlarmCount}" Foreground="White" FontWeight="Bold"
                                   FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="全部确认" Command="{Binding AcknowledgeAllCommand}"
                            Style="{StaticResource ButtonWarning}" Padding="12,5" FontSize="12"
                            Visibility="{Binding HasCriticalAlarm, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Button Content="关闭" Click="CloseButton_Click"
                            Style="{StaticResource ButtonDefault}" Padding="12,5" FontSize="12" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Padding="10,8" Background="{DynamicResource SecondaryBackgroundBrush}">
            <Grid>
                <Button Content="刷新" Command="{Binding RefreshCommand}"
                        Style="{StaticResource ButtonDefault}" HorizontalAlignment="Left" Padding="15,5"/>
                <Button Content="查看全部" Command="{Binding NavigateToDetailCommand}"
                        Style="{StaticResource ButtonPrimary}" HorizontalAlignment="Right" Padding="15,5"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding ActiveAlarms}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                            <Grid Margin="15,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="6" CornerRadius="3" Margin="0,0,12,0"
                                        Background="{Binding AlarmLevel, Converter={StaticResource AlarmLevelToColorConverter}}"
                                        VerticalAlignment="Stretch"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AlarmTitle}" FontWeight="Bold" FontSize="14"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding AlarmContent}" FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap" Margin="0,4,0,0" MaxHeight="50"
                                               TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <hc:Tag Content="{Binding AlarmLevel}" FontSize="10" Padding="6,2"
                                                Style="{StaticResource TagBaseStyle}"
                                                Background="{Binding AlarmLevel, Converter={StaticResource AlarmLevelToColorConverter}}"
                                                Foreground="White"/>
                                        <TextBlock Text="{Binding AlarmSource}" FontSize="11"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="8,0,0,0"/>
                                        <TextBlock Text="{Binding TriggeredTime, StringFormat='{}{0:MM-dd HH:mm}'}"
                                                   FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Vertical" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <Button Content="确认" Command="{Binding DataContext.AcknowledgeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource ButtonWarning}"
                                            Padding="10,4" FontSize="11" Margin="0,0,0,4"
                                            Visibility="{Binding AlarmStatus, Converter={StaticResource AlarmStatusToVisibilityConverter}}"/>
                                    <Button Content="解决" Command="{Binding DataContext.ResolveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource ButtonSuccess}"
                                            Padding="10,4" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding ActiveAlarms.Count, Converter={StaticResource CountToVisibilityConverter}}">
            <TextBlock Text="暂无活跃告警" FontSize="16" Foreground="{DynamicResource SecondaryTextBrush}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="系统运行正常" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"
                       HorizontalAlignment="Center" Margin="0,5,0,0" Opacity="0.7"/>
        </StackPanel>

        <hc:LoadingCircle Grid.Row="2" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                          VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </Grid>
</UserControl>
