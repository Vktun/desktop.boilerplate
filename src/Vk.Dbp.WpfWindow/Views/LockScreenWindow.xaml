<Window x:Class="Dabp.WpfWindow.Views.LockScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Dabp.WpfWindow.ViewModels"
        xmlns:converters="clr-namespace:Dabp.WpfWindow.Converters"
        Title="屏幕锁定"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        WindowState="Maximized">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="BooleanToInverseVisibilityConverter"/>
        <converters:InverseBooleanConverter x:Key="BooleanToInverseConverter"/>
        <converters:InitialConverter x:Key="InitialConverter"/>
    </Window.Resources>
    <Grid Background="{DynamicResource PrimaryBackgroundBrush}">
        <Border Background="{DynamicResource SecondaryBackgroundBrush}"
                CornerRadius="8"
                Opacity="0.95"
                Width="450"
                Height="380"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 用户头像和姓名 -->
                <StackPanel Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,0,30">
                    <Border Width="80" Height="80" CornerRadius="40" Background="{DynamicResource PrimaryBrush}" Margin="0,0,0,15">
                        <TextBlock Text="{Binding Username, Converter={StaticResource InitialConverter}}"
                                   FontSize="32" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding RealName}" FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Username}" FontSize="14"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- 锁屏原因 -->
                <TextBlock Grid.Row="1" Text="{Binding LockReason}" FontSize="14"
                           Foreground="{DynamicResource WarningBrush}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <!-- 密码输入框 -->
                <TextBlock Grid.Row="2" Text="输入密码解锁" Foreground="{DynamicResource PrimaryTextBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <PasswordBox x:Name="PasswordBox" Grid.Row="3"
                             Padding="12,10" Width="300" HorizontalAlignment="Center"
                             Background="{DynamicResource SecondaryBackgroundBrush}"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             BorderThickness="1" FontSize="14"
                             KeyDown="OnPasswordKeyDown"/>

                <!-- 解锁按钮 -->
                <Button Grid.Row="4" Content="解锁" Width="100" Height="40"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Center"
                        Command="{Binding UnlockCommand}"
                        CommandParameter="{Binding ElementName=PasswordBox}"
                        Background="{DynamicResource PrimaryBrush}"
                        Foreground="White" FontSize="14" FontWeight="Bold"
                        Cursor="Hand"
                        IsEnabled="{Binding IsUnlocking, Converter={StaticResource BooleanToInverseConverter}}"/>

                <!-- 错误消息 -->
                <TextBlock Grid.Row="5" Text="{Binding ErrorMessage}" Foreground="Red"
                           TextWrapping="Wrap" Margin="0,15,0,0"
                           HorizontalAlignment="Center"
                           Visibility="{Binding ShowError, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- 退出程序按钮 -->
                <Button Grid.Row="6" Content="退出程序" Width="100" Height="30"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Center"
                        Command="{Binding ExitCommand}"
                        Background="Transparent"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        FontSize="12" Cursor="Hand"/>

                <!-- 锁屏时间 -->
                <TextBlock Grid.Row="6" Text="{Binding LockTimeText}"
                           FontSize="10"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Margin="0,0,0,-20"/>
            </Grid>
        </Border>
    </Grid>
</Window>