<Application x:Class="Vk.Dbp.AdminWindow.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="AdminShellBackgroundColor">#F3F6FA</Color>
            <Color x:Key="AdminSidebarBackgroundColor">#1F2937</Color>
            <Color x:Key="AdminSidebarHoverColor">#2F3B4D</Color>
            <Color x:Key="AdminSidebarSelectedColor">#2563EB</Color>
            <Color x:Key="AdminBorderColor">#DDE4EE</Color>
            <Color x:Key="AdminPrimaryTextColor">#172033</Color>
            <Color x:Key="AdminSecondaryTextColor">#667085</Color>

            <SolidColorBrush x:Key="AdminShellBackgroundBrush" Color="{StaticResource AdminShellBackgroundColor}" />
            <SolidColorBrush x:Key="AdminSidebarBackgroundBrush" Color="{StaticResource AdminSidebarBackgroundColor}" />
            <SolidColorBrush x:Key="AdminSidebarHoverBrush" Color="{StaticResource AdminSidebarHoverColor}" />
            <SolidColorBrush x:Key="AdminSidebarSelectedBrush" Color="{StaticResource AdminSidebarSelectedColor}" />
            <SolidColorBrush x:Key="AdminBorderBrush" Color="{StaticResource AdminBorderColor}" />
            <SolidColorBrush x:Key="AdminPrimaryTextBrush" Color="{StaticResource AdminPrimaryTextColor}" />
            <SolidColorBrush x:Key="AdminSecondaryTextBrush" Color="{StaticResource AdminSecondaryTextColor}" />
            <SolidColorBrush x:Key="AdminPanelBrush" Color="#FFFFFF" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
