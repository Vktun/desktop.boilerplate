<Window x:Class="Vk.Dbp.AdminWindow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:Vk.Dbp.AdminWindow.ViewModels"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="1180"
        Height="720"
        MinWidth="980"
        MinHeight="620"
        Background="{StaticResource AdminShellBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance Type=viewModels:AdminShellViewModel}">
    <Window.Resources>
        <Style x:Key="SidebarMenuItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="12,3" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="12,10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AdminSidebarHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AdminSidebarSelectedBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SummaryCardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource AdminPanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AdminBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AdminShellBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource AdminSidebarBackgroundBrush}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="22,24,22,18">
                    <TextBlock Text="DBP Admin"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF" />
                    <TextBlock Text="管理控制台"
                               Margin="0,6,0,0"
                               FontSize="13"
                               Foreground="#94A3B8" />
                </StackPanel>

                <Border DockPanel.Dock="Bottom"
                        Margin="16"
                        Padding="12"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="运行状态"
                                   FontSize="12"
                                   Foreground="#94A3B8" />
                        <TextBlock Text="本地管理入口"
                                   Margin="0,4,0,0"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#E2E8F0" />
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding MenuItems}"
                         SelectedItem="{Binding SelectedMenuItem, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource SidebarMenuItemStyle}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Width="24"
                                        Height="24"
                                        Background="#1D4ED8"
                                        CornerRadius="4">
                                    <TextBlock Text="{Binding Icon}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="13"
                                               Foreground="#FFFFFF" />
                                </Border>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}" />
                                    <TextBlock Text="{Binding Description}"
                                               Margin="0,3,0,0"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="#94A3B8" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="76" />
                <RowDefinition Height="*" />
                <RowDefinition Height="36" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource AdminPanelBrush}"
                    BorderBrush="{StaticResource AdminBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="30,0">
                <DockPanel LastChildFill="True">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding ContentTitle}"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AdminPrimaryTextBrush}" />
                        <TextBlock Text="{Binding SelectedMenuItem.Description}"
                                   Margin="0,5,0,0"
                                   FontSize="13"
                                   Foreground="{StaticResource AdminSecondaryTextBrush}" />
                    </StackPanel>

                    <Border DockPanel.Dock="Right"
                            Width="150"
                            Height="34"
                            VerticalAlignment="Center"
                            BorderBrush="{StaticResource AdminBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="17">
                        <TextBlock Text="Administrator"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{StaticResource AdminPrimaryTextBrush}" />
                    </Border>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="1"
                          Padding="30"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <UniformGrid Columns="3" Margin="0,0,0,20">
                        <Border Style="{StaticResource SummaryCardStyle}" Margin="0,0,14,0">
                            <StackPanel>
                                <TextBlock Text="今日概览"
                                           FontSize="13"
                                           Foreground="{StaticResource AdminSecondaryTextBrush}" />
                                <TextBlock Text="128"
                                           Margin="0,12,0,0"
                                           FontSize="30"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AdminPrimaryTextBrush}" />
                                <TextBlock Text="待处理任务"
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource AdminSecondaryTextBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SummaryCardStyle}" Margin="7,0">
                            <StackPanel>
                                <TextBlock Text="系统健康"
                                           FontSize="13"
                                           Foreground="{StaticResource AdminSecondaryTextBrush}" />
                                <TextBlock Text="正常"
                                           Margin="0,12,0,0"
                                           FontSize="30"
                                           FontWeight="SemiBold"
                                           Foreground="#15803D" />
                                <TextBlock Text="服务在线"
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource AdminSecondaryTextBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SummaryCardStyle}" Margin="14,0,0,0">
                            <StackPanel>
                                <TextBlock Text="审计事件"
                                           FontSize="13"
                                           Foreground="{StaticResource AdminSecondaryTextBrush}" />
                                <TextBlock Text="36"
                                           Margin="0,12,0,0"
                                           FontSize="30"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AdminPrimaryTextBrush}" />
                                <TextBlock Text="最近 24 小时"
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource AdminSecondaryTextBrush}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Background="{StaticResource AdminPanelBrush}"
                            BorderBrush="{StaticResource AdminBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="26">
                        <StackPanel>
                            <TextBlock Text="{Binding ContentTitle}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AdminPrimaryTextBrush}" />
                            <TextBlock Text="{Binding SelectedMenuItem.Description}"
                                       Margin="0,8,0,0"
                                       FontSize="14"
                                       Foreground="{StaticResource AdminSecondaryTextBrush}" />
                            <Border Margin="0,24,0,0"
                                    MinHeight="260"
                                    Background="#F8FAFC"
                                    BorderBrush="{StaticResource AdminBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <TextBlock Text="右侧内容区域预留：后续可接入用户、角色、权限、配置、审计等管理页面。"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="15"
                                           Foreground="{StaticResource AdminSecondaryTextBrush}" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="{StaticResource AdminPanelBrush}"
                    BorderBrush="{StaticResource AdminBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="30,0">
                <TextBlock Text="Vk.Dbp.AdminWindow"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource AdminSecondaryTextBrush}" />
            </Border>
        </Grid>
    </Grid>
</Window>
