<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    
    <!-- 代码覆盖率配置（coverlet.msbuild：collector 包不读 MSBuild 属性，旧 MinimumRequiredCoverage 是无效假配置）。
         门禁口径：排除 UI 壳工程（WpfWindow/WorkshopModule，以 Views/XAML 为主）与测试基建，
         对业务代码（AccountModule/Contracts/Infrastructure/Services/Utils/AdminWindow 等）设行覆盖回归底线。 -->
    <CollectCoverage>true</CollectCoverage>
    <CoverletOutputFormat>cobertura,json</CoverletOutputFormat>
    <ExcludeByFile>**/*.g.cs,**/*.Designer.cs</ExcludeByFile>
    <Exclude>[Vk.Dbp.WpfWindow]*,[Vk.Dbp.WorkshopModule]*,[Vk.Dbp.Tests.Common]*</Exclude>
    <Threshold>32</Threshold>
    <ThresholdType>line</ThresholdType>
    <ThresholdStat>total</ThresholdStat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Data.SqlClient" Version="4.9.1" />
    <PackageReference Include="xunit" Version="2.6.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <PackageReference Include="coverlet.msbuild" Version="10.1.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Vk.Dbp.AdminWindow\Vk.Dbp.AdminWindow.csproj" />
    <ProjectReference Include="..\..\src\Vk.Dbp.WpfWindow\Vk.Dbp.WpfWindow.csproj" />
    <ProjectReference Include="..\..\prismModules\Vk.Dbp.AccountModule\Vk.Dbp.AccountModule.csproj" />
    <ProjectReference Include="..\..\prismModules\Vk.Dbp.DeviceModule\Vk.Dbp.DeviceModule.csproj" />
    <ProjectReference Include="..\Vk.Dbp.Tests.Common\Vk.Dbp.Tests.Common.csproj" />
  </ItemGroup>

</Project>
